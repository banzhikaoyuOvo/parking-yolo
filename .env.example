# ============================================
# Parking-YOLO 环境变量模板
# 复制为 .env 并填入真实值
# ============================================

# DeepSeek API Key（必填）
# 申请地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-key-here

# LLM API 地址（可选，默认 DeepSeek 官方）
# LLM_BASE_URL=https://api.deepseek.com

# Flask 调试模式（可选，默认 true）
# FLASK_DEBUG=true
